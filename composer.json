{
    "require": {
        "php": "^8.5",
        "slim/slim": "^4",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.8"
    },
    "scripts": {
        "lint:fix": "php-cs-fixer fix",
        "lint:check": "php-cs-fixer fix --dry-run --diff",
        "rector:dry": "vendor/bin/rector process --dry-run",
        "rector:fix": "vendor/bin/rector process",
        "qa": [
            "@rector:fix",
            "@lint:fix"
        ]
    }
}